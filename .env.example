# Copy this file to `.env` (or `.env.development`) for the local environment.
# `npm run start:dev` loads `.env.development` and then `.env`.
# `npm run test:e2e` ignores this file and uses `.env.test`.

# Server
PORT=3000

# Development PostgreSQL (`postgres` container on port 5433)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=parking
POSTGRES_PASSWORD=parking
POSTGRES_DB=parking

# Development MongoDB (`mongo` container on port 27017)
MONGO_URI=mongodb://localhost:27017/parking_logs

# JWT
JWT_SECRET=change-meeeeeee
JWT_EXPIRES_IN=1h
