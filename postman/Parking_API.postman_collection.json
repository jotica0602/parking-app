{
  "info": {
    "name": "Parking API",
    "description": "Importa la colección, ajusta baseUrl y ejecuta Auth → Login para rellenar accessToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "accessToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "vehicleId", "value": "" },
    { "key": "spotId", "value": "" },
    { "key": "reservationId", "value": "" },
    { "key": "sessionId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Alive",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Cliente\",\n  \"email\": \"ana@parking.test\",\n  \"password\": \"Password123!\",\n  \"phone\": \"600111222\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "if (json.user && json.user.id) pm.collectionVariables.set('userId', json.user.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@parking.test\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "if (json.user && json.user.id) pm.collectionVariables.set('userId', json.user.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@parking.test\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Luis Empleado\",\n  \"email\": \"empleado@parking.test\",\n  \"password\": \"Password123!\",\n  \"role\": \"employee\"\n}"
            },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "List users",
          "request": { "method": "GET", "url": "{{baseUrl}}/users" }
        },
        {
          "name": "Get user",
          "request": { "method": "GET", "url": "{{baseUrl}}/users/{{userId}}" }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Editada\",\n  \"phone\": \"611222333\"\n}"
            },
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Delete user",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/users/{{userId}}" }
        }
      ]
    },
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "Create vehicle",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('vehicleId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"licensePlate\": \"1234ABC\",\n  \"brand\": \"Seat\",\n  \"model\": \"Ibiza\",\n  \"color\": \"blue\"\n}"
            },
            "url": "{{baseUrl}}/vehicles"
          }
        },
        {
          "name": "List vehicles",
          "request": { "method": "GET", "url": "{{baseUrl}}/vehicles" }
        },
        {
          "name": "Get vehicle",
          "request": { "method": "GET", "url": "{{baseUrl}}/vehicles/{{vehicleId}}" }
        },
        {
          "name": "Update vehicle",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"color\": \"red\"\n}" },
            "url": "{{baseUrl}}/vehicles/{{vehicleId}}"
          }
        },
        {
          "name": "Delete vehicle",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/vehicles/{{vehicleId}}" }
        }
      ]
    },
    {
      "name": "Spots",
      "item": [
        {
          "name": "Create spot",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('spotId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"A-1\",\n  \"floor\": 0,\n  \"type\": \"standard\"\n}"
            },
            "url": "{{baseUrl}}/spots"
          }
        },
        {
          "name": "List spots",
          "request": { "method": "GET", "url": "{{baseUrl}}/spots" }
        },
        {
          "name": "Get spot",
          "request": { "method": "GET", "url": "{{baseUrl}}/spots/{{spotId}}" }
        },
        {
          "name": "Update spot",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"electric\"\n}" },
            "url": "{{baseUrl}}/spots/{{spotId}}"
          }
        },
        {
          "name": "Delete spot",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/spots/{{spotId}}" }
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "Create reservation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('reservationId', json.id);",
                  "if (json.spotId) pm.collectionVariables.set('spotId', json.spotId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"spotId\": \"{{spotId}}\",\n  \"startAt\": \"2026-09-20T10:00:00.000Z\",\n  \"endAt\": \"2026-09-20T12:00:00.000Z\"\n}"
            },
            "url": "{{baseUrl}}/reservations"
          }
        },
        {
          "name": "List reservations",
          "request": { "method": "GET", "url": "{{baseUrl}}/reservations" }
        },
        {
          "name": "Get reservation",
          "request": { "method": "GET", "url": "{{baseUrl}}/reservations/{{reservationId}}" }
        },
        {
          "name": "Update reservation",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"endAt\": \"2026-09-20T13:00:00.000Z\"\n}"
            },
            "url": "{{baseUrl}}/reservations/{{reservationId}}"
          }
        },
        {
          "name": "Cancel reservation",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/reservations/{{reservationId}}/cancel"
          }
        },
        {
          "name": "Delete reservation",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/reservations/{{reservationId}}" }
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "Register entry",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('sessionId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"spotId\": \"{{spotId}}\",\n  \"reservationId\": \"{{reservationId}}\"\n}"
            },
            "url": "{{baseUrl}}/sessions"
          }
        },
        {
          "name": "List sessions",
          "request": { "method": "GET", "url": "{{baseUrl}}/sessions" }
        },
        {
          "name": "Get session",
          "request": { "method": "GET", "url": "{{baseUrl}}/sessions/{{sessionId}}" }
        },
        {
          "name": "Close session",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/sessions/{{sessionId}}/close"
          }
        },
        {
          "name": "Update session",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"spotId\": \"{{spotId}}\"\n}" },
            "url": "{{baseUrl}}/sessions/{{sessionId}}"
          }
        },
        {
          "name": "Delete session",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/sessions/{{sessionId}}" }
        }
      ]
    },
    {
      "name": "Occupancy",
      "item": [
        {
          "name": "Get occupancy",
          "request": { "method": "GET", "url": "{{baseUrl}}/occupancy" }
        }
      ]
    },
    {
      "name": "Logs",
      "item": [
        {
          "name": "List logs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/logs?action=reservation_created",
              "host": ["{{baseUrl}}"],
              "path": ["logs"],
              "query": [
                { "key": "action", "value": "reservation_created" },
                { "key": "actorId", "value": "", "disabled": true },
                { "key": "from", "value": "", "disabled": true },
                { "key": "to", "value": "", "disabled": true }
              ]
            }
          }
        }
      ]
    }
  ]
}
